[Unit]
Description=Shiba CPU Piper speech sidecar
After=network.target
[Service]
WorkingDirectory=/home/shiba/multikernel-experiment/model-api
ExecStart=/home/shiba/multikernel-experiment/research/piper-venv/bin/python /home/shiba/multikernel-experiment/model-api/tts_backend.py
Restart=on-failure
RestartSec=5
MemoryMax=1G
[Install]
WantedBy=default.target
