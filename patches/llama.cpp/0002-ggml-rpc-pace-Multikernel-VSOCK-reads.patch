From 4606c124473ddb89e93833130151081b2dbcb217 Mon Sep 17 00:00:00 2001
From: qualcunoeq <qualcunoeq@users.noreply.github.com>
Date: Mon, 14 Sep 2026 15:56:27 +0000
Subject: [PATCH 02/15] ggml rpc: pace Multikernel VSOCK reads

Assisted-by: Codex
---
 ggml/src/ggml-rpc/transport.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/ggml/src/ggml-rpc/transport.cpp b/ggml/src/ggml-rpc/transport.cpp
index 04e27ede2..145077fb0 100644
--- a/ggml/src/ggml-rpc/transport.cpp
+++ b/ggml/src/ggml-rpc/transport.cpp
@@ -538,6 +538,11 @@ bool socket_t::impl::recv_data(void * data, size_t size) {
     size_t bytes_recv = 0;
     while (bytes_recv < size) {
         size_t size_to_recv = std::min(size - bytes_recv, MAX_CHUNK_SIZE);
+#if defined(__linux__)
+        if (multikernel) {
+            size_to_recv = std::min(size_to_recv, MK_VSOCK_CHUNK_SIZE);
+        }
+#endif
         ssize_t n = recv(fd, (char *)data + bytes_recv, size_to_recv, 0);
         if (n < 0 && errno == EINTR) {
             continue;
