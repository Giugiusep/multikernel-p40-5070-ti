diff --git a/serve/speech.py b/serve/speech.py
new file mode 100644
index 0000000..652bd77
--- /dev/null
+++ b/serve/speech.py
@@ -0,0 +1,43 @@
+"""Optional CPU speech output for Strata; language generation stays unchanged."""
+import base64
+import json
+import time
+import urllib.request
+import uuid
+
+
+class Speech:
+    def __init__(self, config):
+        self.endpoint = config['endpoint']
+        self.voice = config.get('voice', 'lessac')
+
+    def validate(self, request):
+        modalities = request.get('modalities', ['text'])
+        if not isinstance(modalities, list) or not modalities or any(x not in ('text', 'audio') for x in modalities):
+            raise ValueError('modalities must contain text and/or audio')
+        enabled = 'audio' in modalities
+        if enabled:
+            if request.get('stream'):
+                raise ValueError('Strata speech output currently requires stream=false')
+            audio = request.get('audio', {})
+            if not isinstance(audio, dict) or audio.get('voice', self.voice) != self.voice or audio.get('format', 'wav') != 'wav':
+                raise ValueError('audio must specify voice=lessac and format=wav')
+        return enabled
+
+    def attach(self, response, request):
+        message = response['choices'][0]['message']
+        text = message.get('content')
+        if not text:
+            return response  # tool calls/thinking are not speech
+        if len(text) > 4096:
+            raise ValueError('spoken answer exceeds 4096 characters; reduce max_tokens')
+        body = json.dumps({'model': 'piper-tts', 'voice': self.voice,
+                           'input': text, 'response_format': 'wav'}).encode()
+        req = urllib.request.Request(self.endpoint, data=body, headers={'Content-Type': 'application/json'})
+        with urllib.request.urlopen(req, timeout=120) as reply:
+            if reply.headers.get_content_type() != 'audio/wav':
+                raise ValueError('speech backend returned an unexpected format')
+            data = reply.read()
+        message['audio'] = {'id': 'audio_' + uuid.uuid4().hex, 'expires_at': int(time.time()) + 3600,
+                            'data': base64.b64encode(data).decode(), 'transcript': text}
+        return response
diff --git a/serve/test_speech.py b/serve/test_speech.py
new file mode 100644
index 0000000..20f0186
--- /dev/null
+++ b/serve/test_speech.py
@@ -0,0 +1,19 @@
+import unittest
+from unittest.mock import patch
+from serve.speech import Speech
+
+class SpeechTests(unittest.TestCase):
+    def setUp(self):
+        self.speech = Speech({'endpoint': 'http://127.0.0.1:19083/v1/audio/speech'})
+    def test_text_is_unchanged(self):
+        self.assertFalse(self.speech.validate({}))
+    def test_explicit_audio(self):
+        self.assertTrue(self.speech.validate({'modalities': ['text','audio'], 'audio': {'voice':'lessac','format':'wav'}}))
+    def test_reject_unsupported_before_generation(self):
+        for req in [{'modalities':['audio'],'stream':True}, {'modalities':['audio'],'audio':{'format':'mp3'}}, {'modalities':'audio'}]:
+            with self.assertRaises(ValueError): self.speech.validate(req)
+    def test_never_speak_reasoning_or_tools(self):
+        response={'choices':[{'message':{'content':None,'reasoning_content':'private','tool_calls':[{}]}}]}
+        with patch('serve.speech.urllib.request.urlopen') as call:
+            self.assertIs(self.speech.attach(response, {}),response)
+            call.assert_not_called()
