new file mode 100644
index 0000000..770bbde
--- /dev/null
+++ b/serve/audio_input.py
@@ -0,0 +1,46 @@
+"""Transcribe user audio blocks before Strata's existing text/vision frontend."""
+import copy
+import json
+import urllib.error
+import urllib.request
+
+
+class AudioInput:
+    def __init__(self, config):
+        self.endpoint = config['endpoint']
+
+    def prepare(self, request):
+        request = copy.deepcopy(request)
+        transcripts = []
+        for index, message in enumerate(request.get('messages', [])):
+            content = message.get('content')
+            if not isinstance(content, list):
+                continue
+            for part_index, part in enumerate(content):
+                if not isinstance(part, dict) or part.get('type') != 'input_audio':
+                    continue
+                if message.get('role') != 'user':
+                    raise ValueError('input_audio is supported only in user messages')
+                audio = part.get('input_audio')
+                if not isinstance(audio, dict) or audio.get('format') not in ('wav','mp3') or not isinstance(audio.get('data'), str):
+                    raise ValueError('input_audio requires base64 data and format=wav or mp3')
+                if len(transcripts) >= 4:
+                    raise ValueError('at most four audio blocks per request')
+                body = json.dumps({'model':'whisper-tiny','audio':audio['data'],
+                                   'language':audio.get('language')}).encode()
+                req = urllib.request.Request(self.endpoint, data=body, headers={'Content-Type':'application/json'})
+                try:
+                    with urllib.request.urlopen(req, timeout=120) as response:
+                        result = json.load(response)
+                except urllib.error.HTTPError as exc:
+                    if exc.code == 400:
+                        error = json.loads(exc.read()).get('error', {}).get('message', 'invalid audio')
+                        raise ValueError(error) from exc
+                    raise
+                text = result.get('text')
+                if not isinstance(text, str) or not text.strip():
+                    raise ValueError('no speech recognized in input_audio')
+                content[part_index] = {'type':'text','text':text}
+                transcripts.append({'message_index':index,'part_index':part_index,
+                                    'text':text,'language':result.get('language')})
+        return request, transcripts
