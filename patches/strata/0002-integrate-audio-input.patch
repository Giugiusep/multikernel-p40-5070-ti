diff --git a/serve/test_audio_input.py b/serve/test_audio_input.py
new file mode 100644
index 0000000..81f5919
--- /dev/null
+++ b/serve/test_audio_input.py
@@ -0,0 +1,27 @@
+import copy
+import io
+import json
+import unittest
+from unittest.mock import patch
+from serve.audio_input import AudioInput
+
+class AudioInputTests(unittest.TestCase):
+    def setUp(self):
+        self.adapter=AudioInput({'endpoint':'http://127.0.0.1:19084/v1/audio/transcriptions'})
+    def test_text_preserved(self):
+        request={'messages':[{'role':'user','content':'hello'}]}
+        self.assertEqual(self.adapter.prepare(request),(request,[]))
+    def test_audio_replaced_and_image_preserved(self):
+        request={'messages':[{'role':'user','content':[{'type':'input_audio','input_audio':{'data':'AAAA','format':'wav'}},{'type':'image_url','image_url':{'url':'image'}}]}]}
+        original=copy.deepcopy(request)
+        with patch('serve.audio_input.urllib.request.urlopen') as call:
+            call.return_value.__enter__.return_value=io.BytesIO(json.dumps({'text':'hello','language':'en'}).encode())
+            prepared,transcripts=self.adapter.prepare(request)
+        self.assertEqual(request,original)
+        self.assertEqual(prepared['messages'][0]['content'][0],{'type':'text','text':'hello'})
+        self.assertEqual(prepared['messages'][0]['content'][1],original['messages'][0]['content'][1])
+        self.assertEqual(transcripts[0]['text'],'hello')
+    def test_invalid_role_and_format(self):
+        for role,fmt in [('assistant','wav'),('user','ogg')]:
+            with self.assertRaises(ValueError):
+                self.adapter.prepare({'messages':[{'role':role,'content':[{'type':'input_audio','input_audio':{'data':'AAAA','format':fmt}}]}]})
