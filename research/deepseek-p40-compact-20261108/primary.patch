+    // Missing down weights are never exposed as valid bytes. Hold the slot mutex while
+    // repairing one role; I/O workers only touch job-local completion counters.
+    void ensure_role(int slot,int role) {
+        if(role<0||role>2)throw std::runtime_error("invalid expert role");
+        Slot& sp=slots_[(size_t)slot];const unsigned bit=1u<<role;
+        if(sp.roles.load(std::memory_order_acquire)&bit)return;
+        std::lock_guard<std::mutex> lock(mu_);
+        if(sp.roles.load(std::memory_order_acquire)&bit)return;
+        if(sp.state.load(std::memory_order_acquire)!=kReady)throw std::runtime_error("expert role repair requires a ready slot");
+        const LayerGeo& g=geo_[(size_t)sp.layer];
+        const uint64_t off=g.off[role]+(uint64_t)sp.expert*g.stride[role],lead=off%os::kDirectAlign;
+        uint8_t* fin=sp.base+g.tr[role];
+        std::atomic<int> left{1};std::atomic<bool> bad{false};
+        IoQueue::Job job;job.fd=pfds_[(size_t)g.file[role]];job.dfd=dfds_[(size_t)g.file[role]];job.off=off;job.len=g.bytes[role];job.dst=(uint8_t*)((uintptr_t)(fin-lead)&~(uintptr_t)(os::kDirectAlign-1));job.keep=fin;job.left=&left;job.bad=&bad;
+        const auto start=std::chrono::steady_clock::now();
+        io_->push(&job,1,false);st_.bytes_read.fetch_add(g.bytes[role],std::memory_order_relaxed);
+        while(left.load(std::memory_order_acquire)>0)io_->wait_any(2000);
+        st_.wait_ns.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count(),std::memory_order_relaxed);
+        if(bad.load(std::memory_order_acquire)){st_.fails.fetch_add(1,std::memory_order_relaxed);throw std::runtime_error("deferred expert role read failed");}
+        sp.roles.fetch_or(bit,std::memory_order_release);
+        if(role==2)st_.down_refill_bytes.fetch_add(g.bytes[role],std::memory_order_relaxed);
+    }
