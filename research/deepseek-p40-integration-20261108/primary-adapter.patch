From 6c125cfedcc15025497dc21da47d02d26c4af346 Mon Sep 17 00:00:00 2001
From: qualcunoeq <qualcunoeq@users.noreply.github.com>
Date: Sun, 8 Nov 2026 11:02:31 +0000
Subject: [PATCH] Add opt-in bounded DeepSeek Multikernel expert adapter for
 shadow testing

---
 src/dsv41/ds4_mk_expert.hpp | 71 +++++++++++++++++++++++++++++++++++++
 src/dsv41/ds4_model.cu      | 45 +++++++++++++++++++++++
 2 files changed, 116 insertions(+)
 create mode 100644 src/dsv41/ds4_mk_expert.hpp

diff --git a/src/dsv41/ds4_mk_expert.hpp b/src/dsv41/ds4_mk_expert.hpp
new file mode 100644
index 0000000..be32fbb
--- /dev/null
+++ b/src/dsv41/ds4_mk_expert.hpp
@@ -0,0 +1,71 @@
+#pragma once
+// Experimental primary-only adapter. Default off. No model I/O in the secondary.
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#if defined(__linux__) && !defined(STRATA_USE_HIP)
+#include <sys/socket.h>
+#include <linux/vm_sockets.h>
+#include <unistd.h>
+#include <cerrno>
+namespace strata_mk {
+inline thread_local bool suspended=false;
+struct Pause {bool prior;Pause():prior(suspended){suspended=true;}~Pause(){suspended=prior;}};
+struct Client {
+    struct Header { unsigned magic,version,op,status,seq,bytes; };
+    int fd=-1; unsigned seq=0; size_t resident=0; bool failed=false;
+    std::map<std::pair<int,int>,size_t> cache;
+    std::mutex mu;
+    ~Client(){if(fd>=0)close(fd);}
+    static int mode(){if(suspended)return 0;const char*p=getenv("DS4_MK_EXPERT");return p&&strcmp(p,"shadow")==0?1:p&&strcmp(p,"replace")==0?2:0;}
+    static void append(std::vector<unsigned char>&b,const void*p,size_t n){const auto*q=(const unsigned char*)p;b.insert(b.end(),q,q+n);}
+    static void io(int fd,void*p,size_t n,bool tx){auto*q=(char*)p;unsigned retries=0;while(n){size_t want=std::min(n,size_t(32768));ssize_t k=tx?send(fd,q,want,MSG_NOSIGNAL):recv(fd,q,want,0);if(k<0&&errno==EINTR)continue;if(k<0&&tx&&(errno==ENOSPC||errno==EAGAIN)&&++retries<1000){usleep(100);continue;}if(k<=0)throw std::runtime_error("Multikernel expert socket I/O");q+=k;n-=k;retries=0;if(tx&&n)usleep(100);}}
+    std::vector<unsigned char> call(unsigned op,std::vector<unsigned char>&b){
+        if(fd<0){fd=socket(AF_VSOCK,SOCK_STREAM,0);int t=1;sockaddr_vm a{};a.svm_family=AF_VSOCK;a.svm_cid=1;a.svm_port=6011;
+            if(fd<0||setsockopt(fd,AF_VSOCK,9,&t,sizeof(t)))throw std::runtime_error("Multikernel transport selection");
+            timeval timeout{15,0};setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,&timeout,sizeof(timeout));setsockopt(fd,SOL_SOCKET,SO_SNDTIMEO,&timeout,sizeof(timeout));
+            if(connect(fd,(sockaddr*)&a,sizeof(a)))throw std::runtime_error("Multikernel expert connect");}
+        Header h{0x4458454d,2,op,0,++seq,(unsigned)b.size()};io(fd,&h,sizeof(h),true);io(fd,b.data(),b.size(),true);Header r{};io(fd,&r,sizeof(r),false);
+        if(r.magic!=h.magic||r.version!=2||r.op!=op||r.seq!=seq||r.bytes>16*1024*1024)throw std::runtime_error("Multikernel expert framing");
+        std::vector<unsigned char> out(r.bytes);io(fd,out.data(),out.size(),false);if(r.status)throw std::runtime_error(std::string("Multikernel worker rejected: ")+std::string(out.begin(),out.end()));return out;
+    }
+    template<class Loader> bool run(int l,int e,int tg,int td,int rows,const float*x,size_t stride,Loader load,std::vector<float>&out){
+        std::lock_guard<std::mutex> lock(mu);if(failed||rows<1||rows>8||!(tg==16||tg==17||tg==22)||!(td==16||td==17||td==22||td==18))return false;
+        try{
+            const auto key=std::make_pair(l,e);
+            if(!cache.count(key)){
+                // Fixed bounded cache; admission stops at 1GiB. No eviction/upload churn.
+                if(resident+12*1024*1024>1024ull*1024*1024)return false;
+                std::vector<unsigned char>b;unsigned meta[8]={(unsigned)l,(unsigned)e,(unsigned)tg,(unsigned)td,5120,2304,0,0};append(b,meta,32);
+                size_t gu=0,dn=0;load(b,gu,dn);if(b.size()!=32+2*gu+dn||b.size()>16*1024*1024||resident+b.size()-32>1024ull*1024*1024)return false;
+                meta[6]=(unsigned)gu;meta[7]=(unsigned)dn;memcpy(b.data(),meta,32);auto reply=call(1,b);if(!reply.empty())throw std::runtime_error("LOAD reply");cache[key]=b.size()-32;resident+=b.size()-32;
+                fprintf(stderr,"mk expert load layer=%d expert=%d bytes=%zu resident=%zu\n",l,e,b.size()-32,resident);
+            }
+            std::vector<signed char>q(rows*5120);std::vector<float>d(rows*160);
+            std::vector<unsigned char> packed(20*292);
+            for(int r=0;r<rows;r++){
+                // GGML_TYPE_Q8_K=15, block: float d; int8 qs[256]; int16 bsums[16].
+                strata::ds4::gguf::iq_cpu_quant(15,x+r*stride,5120,packed.data());
+                for(int b=0;b<20;b++){float sc;memcpy(&sc,packed.data()+b*292,4);memcpy(q.data()+r*5120+b*256,packed.data()+b*292+4,256);for(int j=0;j<8;j++)d[r*160+b*8+j]=sc;}
+            }
+            unsigned meta[4]={(unsigned)l,(unsigned)e,(unsigned)rows,0};std::vector<unsigned char>b;append(b,meta,16);append(b,q.data(),q.size());append(b,d.data(),d.size()*4);auto reply=call(2,b);
+            unsigned hdr[4];if(reply.size()!=28+size_t(rows)*5120*4)throw std::runtime_error("RUN reply size");memcpy(hdr,reply.data(),16);if(hdr[0]!=(unsigned)rows||hdr[1]||hdr[2]!=5120||hdr[3]!=2304)throw std::runtime_error("RUN metadata");out.resize(rows*5120);memcpy(out.data(),reply.data()+28,out.size()*4);for(float v:out)if(!std::isfinite(v))throw std::runtime_error("nonfinite output");return true;
+        }catch(const std::exception&e){fprintf(stderr,"mk expert disabled: %s (CPU fallback)\n",e.what());failed=true;if(fd>=0){close(fd);fd=-1;}return false;}
+    }
+};
+// One expert may occupy several entries in a long prompt. ID alone is not a slot identity.
+template<class Entry> bool same_entry(const Entry&a,const Entry&b){
+    if(a.e!=b.e||a.n!=b.n||a.slot0!=b.slot0)return false;
+    for(int i=0;i<a.n;i++)if(a.tok[i]!=b.tok[i])return false;
+    return true;
+}
+inline Client& client(){static Client c;return c;}
+}
+#endif
diff --git a/src/dsv41/ds4_model.cu b/src/dsv41/ds4_model.cu
index 6a4b6c0..ac781bd 100644
--- a/src/dsv41/ds4_model.cu
+++ b/src/dsv41/ds4_model.cu
@@ -21,6 +21,7 @@
 #include "ds4_gguf.cuh"
 #include "ds4_iq.cuh"
 #include "ds4_gguf_cpu.hpp"
+#include "ds4_mk_expert.hpp"
 #include "ds4_kernels.cuh"
 #include "ds4_os.hpp"
 #include "ds4_pool.hpp"
@@ -6624,6 +6625,47 @@ struct Model::Impl {
     }
 #endif
     void cpu_experts_iq(const Layer& l, const float* x, const std::vector<Ent>& ents, size_t ldx, const int* ord) {
+#if defined(__linux__) && !defined(STRATA_USE_HIP)
+        // Inputs are still FP32 here; later CPU quantization aliases c_xh.
+        // Shadow compares real CPU-lane contributions without changing them.
+        std::vector<std::pair<Ent,std::vector<float>>> mk_results;
+        const int mk_mode = strata_mk::Client::mode();
+        if (mk_mode && NH == 1 && g.dim == 5120 && g.ff == 2304 && g.lim == 10.f) {
+            for (const Ent& en : ents) {
+                std::vector<float> input((size_t)en.n * g.dim), output;
+                for (int i=0;i<en.n;i++) std::memcpy(input.data()+(size_t)i*g.dim,x+(size_t)en.tok[i]*ldx,g.dim*4);
+                auto loader = [&](std::vector<unsigned char>& b,size_t& gu,size_t& dn) {
+                    gu=mx_part_bytes(l,0); dn=mx_part_bytes(l,2);
+                    if (mx_part_bytes(l,1)!=gu) throw std::runtime_error("gate/up size mismatch");
+                    for(int role=0;role<3;role++) strata_mk::Client::append(b,mx_part_ptr(l,en.e,role,0),mx_part_bytes(l,role));
+                };
+                if(strata_mk::client().run(l.il,en.e,gg::expert_type(l.lay,0),gg::expert_type(l.lay,2),en.n,input.data(),g.dim,loader,output))
+                    mk_results.push_back({en,std::move(output)});
+            }
+            if(mk_mode==2 && !mk_results.empty()) {
+                std::vector<Ent> remaining;
+                for(const Ent& en:ents) {
+                    auto it=std::find_if(mk_results.begin(),mk_results.end(),[&](const auto& v){return strata_mk::same_entry(v.first,en);});
+                    if(it==mk_results.end()) remaining.push_back(en);
+                    else {std::memcpy(c_yd.data()+(size_t)en.slot0*g.dim,it->second.data(),(size_t)en.n*g.dim*4);}
+                }
+                // Temporarily suppress adapter recursion while retaining the CPU fallback.
+                if(!remaining.empty()) cpu_experts_iq_local(l,x,remaining,ldx,nullptr);
+                return;
+            }
+        }
+#endif
+        cpu_experts_iq_local(l,x,ents,ldx,ord);
+#if defined(__linux__) && !defined(STRATA_USE_HIP)
+        for(const auto& item:mk_results) {
+            const Ent& en=item.first;double err=0,ref=0,mx=0;
+            const float* cpu=c_yd.data()+(size_t)en.slot0*g.dim;
+            for(size_t j=0;j<item.second.size();j++){double d=std::abs(double(cpu[j])-item.second[j]);err+=d;ref+=std::abs(cpu[j]);mx=std::max(mx,d);}
+            std::fprintf(stderr,"mk expert shadow layer=%d expert=%d rows=%d rel_l1=%.9g max_abs=%.9g\n",l.il,en.e,en.n,err/std::max(ref,1e-30),mx);
+        }
+#endif
+    }
+    void cpu_experts_iq_local(const Layer& l, const float* x, const std::vector<Ent>& ents, size_t ldx, const int* ord) {
         constexpr int RB = 64;   // rows a job
         const int E = g.dim, FF = g.ff, FFh = FF / NH, Eh = E / NH;
         const int GB = (FFh + RB - 1) / RB, DB = (Eh + RB - 1) / RB, ne = (int) ents.size();
@@ -8894,6 +8936,9 @@ struct Model::Impl {
     // RAM and on ones it reads from the disk first - each timed once, a few experts' worth (DS4_PATH_PICK=0: always the
     // flow, as before)
     void calibrate_paths() {
+#if defined(__linux__) && !defined(STRATA_USE_HIP)
+        strata_mk::Pause mk_calibration_guard;
+#endif
         if (chunk <= 0 || chunk_min != kFlowChunkMin || std::getenv("DS4_CHUNK_MIN") != nullptr) return;
         if (const char* v = std::getenv("DS4_PATH_PICK"))
             if (std::atoi(v) == 0) return;
