+        std::vector<unsigned char> out(r.bytes);io(fd,out.data(),out.size(),false);if(r.status)throw std::runtime_error(std::string("Multikernel worker rejected: ")+std::string(out.begin(),out.end()));++requests;down_requests+=op==4;protocol_bytes+=48+b.size()+out.size();if(trace)fprintf(stderr,"mk rx seq=%u op=%u bytes=%u\n",seq,op,r.bytes);return out;
     }
-    template<class Loader> bool run(int l,int e,int tg,int td,int rows,const float*x,size_t stride,Loader load,std::vector<float>&out){
