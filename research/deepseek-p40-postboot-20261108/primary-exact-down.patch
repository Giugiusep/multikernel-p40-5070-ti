             for(int r=0;r<rows;r++){
                 // GGML_TYPE_Q8_K=15, block: float d; int8 qs[256]; int16 bsums[16].
-                strata::ds4::gguf::iq_cpu_quant(15,x+r*stride,5120,packed.data());
-                for(int b=0;b<20;b++){float sc;memcpy(&sc,packed.data()+b*292,4);memcpy(q.data()+r*5120+b*256,packed.data()+b*292+4,256);for(int j=0;j<8;j++)d[r*160+b*8+j]=sc;}
+                strata::ds4::gguf::iq_cpu_quant(15,x+r*stride,dim,packed.data());
+                for(int b=0;b<dim/256;b++){float sc;memcpy(&sc,packed.data()+b*292,4);memcpy(q.data()+r*dim+b*256,packed.data()+b*292+4,256);for(int j=0;j<8;j++)d[r*(dim/32)+b*8+j]=sc;}
             }
-            unsigned meta[4]={(unsigned)l,(unsigned)e,(unsigned)rows,0};std::vector<unsigned char>b;append(b,meta,16);append(b,q.data(),q.size());append(b,d.data(),d.size()*4);auto reply=call(2,b);
+            unsigned meta[4]={(unsigned)l,(unsigned)e,(unsigned)rows,0};std::vector<unsigned char>b;append(b,meta,16);append(b,q.data(),q.size());append(b,d.data(),d.size()*4);auto reply=call(down_only?4:2,b);
             unsigned hdr[4];if(reply.size()!=28+size_t(rows)*5120*4)throw std::runtime_error("RUN reply size");memcpy(hdr,reply.data(),16);if(hdr[0]!=(unsigned)rows||hdr[1]||hdr[2]!=5120||hdr[3]!=2304)throw std::runtime_error("RUN metadata");out.resize(rows*5120);memcpy(out.data(),reply.data()+28,out.size()*4);for(float v:out)if(!std::isfinite(v))throw std::runtime_error("nonfinite output");return true;
         }catch(const std::exception&e){fprintf(stderr,"mk expert disabled: %s (CPU fallback)\n",e.what());failed=true;if(fd>=0){close(fd);fd=-1;}return false;}
