+    static void io(int fd,void*p,size_t n,bool tx){auto*q=(char*)p;unsigned retries=0;while(n){size_t want=std::min(n,size_t(32768));ssize_t k=tx?send(fd,q,want,MSG_NOSIGNAL):recv(fd,q,want,0);if(k<0&&errno==EINTR)continue;if(k<0&&tx&&(errno==ENOSPC||errno==EAGAIN)&&++retries<1000){usleep(100);continue;}if(k<=0)throw std::runtime_error(std::string("Multikernel expert socket I/O: ")+strerror(errno));q+=k;n-=k;retries=0;if(tx&&n)usleep(100);}}
     std::vector<unsigned char> call(unsigned op,std::vector<unsigned char>&b){
