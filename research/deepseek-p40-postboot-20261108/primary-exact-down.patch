+    static size_t limit(){const char*p=getenv("DS4_MK_CACHE_MIB");long v=p?std::strtol(p,nullptr,10):1024;if(v<16||v>1024)throw std::runtime_error("invalid DS4_MK_CACHE_MIB");return size_t(v)*1024*1024;}
