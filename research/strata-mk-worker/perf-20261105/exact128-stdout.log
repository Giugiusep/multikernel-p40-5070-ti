 than compressed. As the cables sag under the weight of the deck, they exert a massive downward vertical force on the towers, which in turn transmit this load to the foundation, while simultaneously generating a powerful horizontal tension that pulls the towers inward. To counteract this horizontal pull and prevent the towers from collapsing, the main cables are anchored at both ends to massive, heavy concrete or rock anchorages embedded in the ground, which provide", "done": "DONE 192 26 473.1 6857.4 length 98 166 0", "request_wall_seconds": 7.33091654299642, "resources_before": {"memory_events": {"low": 0, "high": 0, "max": 0, "oom": 0, "oom_kill": 0, "oom_group_kill": 0, "sock_throttled": 0}, "memory_current": 42041077760, "cpu_stat": {"usage_usec": 103474039, "user_usec": 96161216, "system_usec": 7312823, "nice_usec": 0, "core_sched.force_idle_usec": 0, "nr_periods": 0, "nr_throttled": 0, "throttled_usec": 0, "nr_bursts": 0, "burst_usec": 0}, "memory_pressure": "some avg10=0.00 avg60=0.00 avg300=0.00 total=7937\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=7937", "guest_cpu_ticks": [5806563, 666, 403191, 130624404, 221507, 0, 63423, 4488, 45965, 0], "process_minor_faults": 8996155, "process_major_faults": 332, "process_cpu_ticks": 10318}, "resources_after": {"memory_events": {"low": 0, "high": 0, "max": 0, "oom": 0, "oom_kill": 0, "oom_group_kill": 0, "sock_throttled": 0}, "memory_current": 42041171968, "cpu_stat": {"usage_usec": 157488808, "user_usec": 150067293, "system_usec": 7421515, "nice_usec": 0, "core_sched.force_idle_usec": 0, "nr_periods": 0, "nr_throttled": 0, "throttled_usec": 0, "nr_bursts": 0, "burst_usec": 0}, "memory_pressure": "some avg10=0.00 avg60=0.00 avg300=0.00 total=7937\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=7937", "guest_cpu_ticks": [5812275, 666, 403217, 130624465, 221564, 0, 63424, 4489, 45967, 0], "process_minor_faults": 9024898, "process_major_faults": 332, "process_cpu_ticks": 15718}}
