+    const char* thp = std::getenv("STRATA_ARENA_THP");
+    if(p != MAP_FAILED && thp && std::strcmp(thp,"1")==0){
+        if(madvise(p,bytes,MADV_HUGEPAGE)==0)
+            note="MADV_HUGEPAGE accepted; actual backing must be checked in smaps";
+        else note="MADV_HUGEPAGE refused; using normal anonymous pages";
+    }
     return p == MAP_FAILED ? nullptr : p;
 #endif
 }
